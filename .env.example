# ==============================================================================
# GLOBAL IMPORT-EXPORT BUYER ACQUISITION SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Settings
APP_NAME="Global Buyer Acquisition Engine"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# Database Configuration
# Local SQLite for zero-setup MVP: sqlite:///./impex_leads.db
# Production PostgreSQL / Supabase: postgresql://postgres:password@localhost:5432/impex_leads
DATABASE_URL="sqlite:///./impex_leads.db"

# Security & Authentication
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# AI / LLM Provider Configuration
# Choose between: gemini, openai, or mock (for offline testing)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_MODEL="gemini-1.5-pro"

# Email Sending (Hostinger / Standard SMTP)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="Indian Export Corp"
SMTP_FROM_EMAIL=""
SMTP_USE_SSL=true

# Outreach Safety & Compliance Limits
DAILY_SEND_LIMIT=50
HOURLY_SEND_LIMIT=10
DEFAULT_OUTREACH_MODE="assisted" # "assisted" (Mode A - Manual Approval) or "automated" (Mode B)
ENABLE_AUTO_FOLLOWUPS=false

# External Trade APIs (Optional / Free Tiers)
UN_COMTRADE_API_KEY=""
APEDA_PORTAL_USER=""
DGFT_PORTAL_USER=""

